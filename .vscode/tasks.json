{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build CUDA",
            "type": "process",
            "command": "nvcc",
            "args": [
                "-g",
                "-G",
                "-ccbin", 
                "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$nvcc"
            ]
        }
    ]
}